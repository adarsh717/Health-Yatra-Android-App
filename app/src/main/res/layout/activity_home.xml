<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBFC"
    app:layoutDescription="@xml/activity_home_scene">

    <!-- ============================ -->
    <!-- Top App Bar -->
    <!-- ============================ -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="80dp"
android:layout_marginTop="35dp"
        android:background="@drawable/gradient_background"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- App Logo -->

        <ImageView
            android:id="@+id/ivTopLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="18dp"
            android:contentDescription="@string/LogoImage"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_health_logo"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- App Name -->

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/health_yatra"
            android:textColor="#123F5A"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvHelp"
            app:layout_constraintStart_toEndOf="@id/ivTopLogo" />


        <!-- Help -->

        <TextView
            android:id="@+id/tvHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="@string/help"
            android:textColor="#009688"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ============================ -->
    <!-- Fragment Container -->
    <!-- ============================ -->

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/authFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        tools:layout="@layout/fragment_sign_up" />

</androidx.constraintlayout.motion.widget.MotionLayout>