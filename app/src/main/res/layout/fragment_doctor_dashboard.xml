<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- First Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Find Patient -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFindPatient"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="20dp"
            app:strokeColor="#F0F3F5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="⌕"
                    android:textColor="#078568"
                    android:textSize="32sp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Find Patient"
                    android:textColor="#14251F"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="by Aadhaar"
                    android:textColor="#455B54"
                    android:textSize="11sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add New Patient -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAddPatient"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="20dp"
            app:strokeColor="#F0F3F5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="♟+"
                    android:textColor="#078568"
                    android:textSize="23sp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Add New"
                    android:textColor="#14251F"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient"
                    android:textColor="#455B54"
                    android:textSize="11sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Second Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Today's Appointments -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAppointments"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="20dp"
            app:strokeColor="#F0F3F5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#078568"
                    android:textSize="27sp"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Today's"
                    android:textColor="#14251F"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Appointments"
                    android:textColor="#455B54"
                    android:textSize="11sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- View All Patients -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAllPatients"
            android:layout_width="0dp"
            android:layout_height="112dp"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="20dp"
            app:strokeColor="#F0F3F5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:textColor="#1675F5"
                    android:textSize="26sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="View All"
                    android:textColor="#14251F"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patients"
                    android:textColor="#455B54"
                    android:textSize="11sp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</LinearLayout>
