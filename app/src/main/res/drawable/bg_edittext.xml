<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="#00FBFBFB" />

            <stroke
                android:width="2dp"
                android:color="#4BD9AC" />

            <corners android:radius="18dp" />

            <padding
                android:left="16dp"
                android:top="0dp"
                android:right="16dp"
                android:bottom="0dp" />

        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape android:shape="rectangle">

            <solid android:color="#00FBFBFB" />

            <stroke
                android:width="1dp"
                android:color="#040404" />

            <corners android:radius="18dp" />

            <padding
                android:left="16dp"
                android:top="0dp"
                android:right="16dp"
                android:bottom="0dp" />

        </shape>
    </item>

</selector>